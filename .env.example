# Copy this to .env and fill in once the SharePoint Excel workbook is ready.
# Until these are set, the app runs entirely on local files
# (server/data/comms.csv and server/data/feedback.json) — nothing here is
# required to develop or demo the app today.

# ── Azure AD (Entra ID) app registration ───────────────────────────────────
# This needs to be created by whoever administers RMIT's Microsoft 365
# tenant (or by you, if you have permission to register apps). Steps:
#
# 1. https://entra.microsoft.com -> App registrations -> New registration
#      Name: "Comms Calendar" (anything works)
#      Supported account types: single tenant
# 2. Certificates & secrets -> New client secret -> copy the VALUE
#      (not the secret ID) into AZURE_CLIENT_SECRET below. It's only
#      shown once.
# 3. API permissions -> Add a permission -> Microsoft Graph
#      -> Application permissions (NOT delegated — this is what lets the
#      app read/write the file with no per-user Microsoft login)
#      -> add "Sites.Selected"
#      -> "Grant admin consent" (an admin needs to click this)
# 4. Sites.Selected only grants access to sites you explicitly authorise.
#    Someone with SharePoint admin rights needs to run (PowerShell,
#    PnP.PowerShell module):
#      Grant-PnPAzureADAppSitePermission -AppId <client-id> `
#        -DisplayName "Comms Calendar" -Site <site-url> -Permissions Write
# 5. Overview page -> copy Application (client) ID and Directory (tenant) ID
#    into AZURE_CLIENT_ID / AZURE_TENANT_ID below.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Where the Excel file lives ─────────────────────────────────────────────
# Preferred: SharePoint site URL + the file's path within that site's
# document library (works with the Sites.Selected setup above).
EXCEL_SITE_URL=https://rmit.sharepoint.com/sites/YourTeamSite
EXCEL_FILE_PATH=/Shared Documents/comms-calendar.xlsx

# Alternative to the two lines above: a "Copy link" share URL for the file
# (needs Files.ReadWrite.All instead of Sites.Selected — broader access,
# simpler to set up, but less scoped).
# EXCEL_SHARE_URL=https://rmit.sharepoint.com/:x:/s/YourTeamSite/Ez...

# ── Table names inside the workbook ─────────────────────────────────────────
# The workbook needs two Excel Tables (Insert > Table, with headers):
#   CommsTable    columns: id, team, title, cta, type, school_year, month,
#                          day, moment, triggers, secondary_cta_1,
#                          secondary_cta_2  (same as server/data/comms.csv)
#   FeedbackTable columns: id, comm_id, author, comment, metric_label,
#                          metric_value, created_at
EXCEL_COMMS_TABLE=CommsTable
EXCEL_FEEDBACK_TABLE=FeedbackTable

# ── Local API server port (the React app calls this via a Vite proxy) ──────
API_PORT=5174

# ── Remote store: Redis over REST (Vercel KV / Upstash) ────────────────────
# Backs BOTH kinds of remote data (see server/registry.ts):
#   datasets    — reference data built from the CSVs in git and pushed with
#                 `npm run seed`; pages read them from /api/dataset/<name> and
#                 fall back to their committed snapshot if unreachable.
#   collections — review answers and comments, appended via
#                 /api/collection/<name> (and the older /api/feedback,
#                 /api/edm-review URLs, which use the same store).
# Used by BOTH the deployed Vercel function (api/feedback.ts) AND the local
# dev server (npm run dev). The deployed build ships static files, so
# api/feedback.ts is what receives notes there; setting these two vars in
# `.env` now also points `npm run dev` at the same Redis, so you can exercise
# the real path locally before deploying. Feedback precedence is
# SharePoint Graph (AZURE_*/EXCEL_* above) → Redis → local file / 503.
#
# Set it up in about two minutes:
#   Vercel -> your project -> Storage -> Create -> Upstash for Redis
#   (Marketplace). Connect it to the project and Vercel injects
#   KV_REST_API_URL and KV_REST_API_TOKEN automatically — nothing to paste.
#
# For local dev, pull those two values into a gitignored `.env`
# (`vercel env pull .env`, or copy them from the Upstash / Vercel dashboard) —
# NOT into this example file, which is committed. UPSTASH_REDIS_REST_URL /
# UPSTASH_REDIS_REST_TOKEN are accepted as alternative names for the same pair.
#
# Note: Vercel's Upstash marketplace integration PREFIXES the injected vars with
# your store name (e.g. rmit_KV_REST_API_URL / rmit_KV_REST_API_TOKEN). That's
# fine — server/redis.ts auto-detects any *_KV_REST_API_URL / *_KV_REST_API_TOKEN
# pair, so paste whatever `vercel env pull` gives you verbatim.
#
# With neither this nor Graph configured, the DEPLOYED site answers 503 and the
# note stays in the composer with the reason (never silently dropped); local
# dev instead falls back to server/data/feedback.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Prototype password gate (middleware.ts) ────────────────────────────────
# Defaults are baked in; override per environment if you want.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
